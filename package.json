{
  "name": "optik-falkner-app",
  "version": "0.2.0",
  "private": true,
  "description": "Kunden-App Optik Falkner (Perg & Dimbach) – Prototyp",
  "scripts": {
    "android:add": "cap add android",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor \"#c4161c\" --iconBackgroundColorDark \"#c4161c\" --splashBackgroundColor \"#26262b\" --splashBackgroundColorDark \"#121214\"",
